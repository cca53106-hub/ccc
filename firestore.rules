rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && 
             request.auth.token.email == email && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprints
    function isValidGalleryImage(data) {
      return data.keys().hasAll(['url', 'alt', 'uploadedBy', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.url is string && data.url.size() <= 1000 &&
             data.alt is string && data.alt.size() <= 200 &&
             data.uploadedBy == 'mehaalkhan.2@gmail.com' &&
             data.createdAt == request.time;
    }

    // Collection match
    match /achievements_gallery/{imageId} {
      // 8. Secure List Queries: Explicitly allow reading
      allow read: if true; 

      // 1. Mandatory Size Enforcements & Identity Integrity
      allow create: if isOwner('mehaalkhan.2@gmail.com') && 
                      isValidId(imageId) && 
                      isValidGalleryImage(incoming());
      
      // Prevent any updates or deletions for now to keep it immortal
      allow update, delete: if false;
    }
  }
}
